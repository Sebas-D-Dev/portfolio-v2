# Optional contact form configuration. Values are embedded in the public bundle.
# Never place private keys or service credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_USER_MESSAGE=
NEXT_PUBLIC_EMAILJS_TEMPLATE_AUTO_REPLY=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Build target: true for GitHub Pages, omit/false for a root-domain export.
GITHUB_PAGES=false
# Set only if the canonical public deployment changes; include a trailing slash.
SITE_URL=https://sebas-d-dev.github.io/portfolio-v2/
